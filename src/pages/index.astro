---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE_DESCRIPTION, SITE_TITLE, url } from '../consts';

const posts = (await getCollection('posts', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
const latest = posts.slice(0, 6);

const orgJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: SITE_TITLE,
  description: SITE_DESCRIPTION,
  url: 'https://thisisparth187.github.io/small-space-style/',
};
---

<BaseLayout
  title={SITE_TITLE}
  description={SITE_DESCRIPTION}
  animateHero
  jsonLd={orgJsonLd}
>
  <section class="hero">
    <div class="wrap">
      <p class="eyebrow">Small spaces · Rentals · Honest picks</p>
      <h1>Houses of light, made to fit a small room.</h1>
      <p>
        Home decor buying guides for small living rooms and rentals — sofas that
        actually fit through the door, upgrades that need no drilling, and rooms
        put together on a real budget. No face, no fluff, just measurements.
      </p>
      <a class="cta" href={url('/blog/')}>Read the guides →</a>
    </div>
  </section>

  <section class="page">
    <div class="wrap">
      <h2>Start here: small spaces &amp; rentals</h2>
      <p>
        This blog is for one reader: someone in a small apartment or a rented
        home who wants it to feel finished — without buying furniture that
        doesn't fit, drilling holes in a wall they don't own, or spending
        furniture-store money. Every guide gives real measurements in inches
        and feet first, prices in dollars, and says who a pick is
        <em>not</em> for. That honesty is the whole point.
      </p>
      <p>
        <strong>How this site earns:</strong> some links are affiliate links.
        If you buy through them, I may earn a commission at no extra cost to
        you. It never changes what I recommend — the picks are chosen first,
        the links come second.
      </p>

      <h2>Latest guides</h2>
      {
        latest.length === 0 ? (
          <p>Guides are on the way — the first one is being written now.</p>
        ) : (
          <ul class="post-list">
            {latest.map((post) => (
              <li class="post-card">
                <h3>
                  <a href={url(`/blog/${post.id}/`)}>{post.data.title}</a>
                </h3>
                <p>{post.data.description}</p>
                <p class="meta">
                  {post.data.pubDate.toLocaleDateString('en-US', {
                    year: 'numeric',
                    month: 'long',
                    day: 'numeric',
                  })}
                </p>
              </li>
            ))}
          </ul>
        )
      }
      <p><a href={url('/blog/')}>Browse all guides →</a></p>
    </div>
  </section>
</BaseLayout>
