---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Contact"
  description="Contact Small Space Style — questions, corrections and suggestions for small-space home decor guides."
>
  <section class="page">
    <div class="wrap">
      <h1>Contact</h1>
      <p>
        Questions about a guide, a measurement that looks wrong, or a product
        you think should be in a comparison? I'd like to hear it — corrections
        make the guides better for everyone.
      </p>
      <p>
        Email: <strong>parthmpune@gmail.com</strong>
      </p>
      <p>
        Please note: this site does not sell furniture and cannot help with
        orders, shipping or returns from any retailer. For those, please
        contact the retailer directly.
      </p>
    </div>
  </section>
</BaseLayout>
