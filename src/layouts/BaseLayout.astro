---
/**
 * Base layout: CALÇ-inspired theme — warm cream frame, dusk slate-blue,
 * lime-plaster white, warm amber glow, elegant serif headlines.
 * Animations live ONLY on the home hero (`.hero-anim`); post pages ship
 * near-zero JS and no animation, so they stay fast.
 */
import Seo from '../components/Seo.astro';
import { SITE_TAGLINE, SITE_TITLE, url } from '../consts';

interface Props {
  title?: string;
  description?: string;
  type?: 'website' | 'article';
  pubDate?: Date;
  updatedDate?: Date;
  tags?: string[];
  jsonLd?: Record<string, unknown>;
  /** Add the hero entrance animation (home page only). */
  animateHero?: boolean;
}

const {
  title = SITE_TITLE,
  description = SITE_TAGLINE,
  type = 'website',
  pubDate,
  updatedDate,
  tags,
  jsonLd,
  animateHero = false,
} = Astro.props;
---

<!doctype html>
<html lang="en-US">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href={url('/favicon.svg')} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,500;0,600;0,700;1,500&family=Inter:wght@400;500;600&display=swap"
      rel="stylesheet"
    />
    <Seo
      title={title}
      description={description}
      type={type}
      pubDate={pubDate}
      updatedDate={updatedDate}
      tags={tags}
      jsonLd={jsonLd}
    />
  </head>
  <body class={animateHero ? 'animate-hero' : ''}>
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="site-header">
      <div class="wrap header-inner">
        <a class="brand" href={url('/')}>{SITE_TITLE}</a>
        <nav aria-label="Main navigation">
          <a href={url('/')}>Home</a>
          <a href={url('/blog/')}>Blog</a>
          <a href={url('/about/')}>About</a>
          <a href={url('/contact/')}>Contact</a>
        </nav>
      </div>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="wrap">
        <p>
          <strong>{SITE_TITLE}</strong> — {SITE_TAGLINE}
        </p>
        <p class="footer-links">
          <a href={url('/disclosure/')}>Affiliate Disclosure</a> ·
          <a href={url('/privacy-policy/')}>Privacy Policy</a> ·
          <a href={url('/disclaimer/')}>Disclaimer</a> ·
          <a href={url('/rss.xml')}>RSS</a>
        </p>
        <p class="fineprint">
          This site contains affiliate links. If you buy through them, I may earn a
          commission at no extra cost to you. Prices and availability change — always
          check the retailer page before you buy.
        </p>
      </div>
    </footer>
  </body>
</html>

<style is:global>
  :root {
    --cream: #f3eee3;
    --cream-soft: #faf7ef;
    --lime-white: #fbfaf6;
    --slate: #2e3a4a;
    --slate-deep: #22303f;
    --dusk: #4a5a70;
    --amber: #d9a441;
    --amber-soft: #f0d9a8;
    --ink: #2b2b26;
    --muted: #5c5c52;
    --line: #ddd5c2;
    --serif: 'Cormorant Garamond', Georgia, 'Times New Roman', serif;
    --sans: 'Inter', system-ui, -apple-system, 'Segoe UI', sans-serif;
  }
  * { box-sizing: border-box; }
  html { scroll-behavior: smooth; }
  body {
    margin: 0;
    font-family: var(--sans);
    font-size: 1.05rem;
    line-height: 1.7;
    color: var(--ink);
    background: var(--cream);
  }
  .wrap { max-width: 760px; margin: 0 auto; padding: 0 1.25rem; }
  .wrap.wide { max-width: 1020px; }
  h1, h2, h3 { font-family: var(--serif); color: var(--slate-deep); line-height: 1.15; }
  h1 { font-size: clamp(2.1rem, 5vw, 3.1rem); font-weight: 600; margin: 0.2em 0 0.4em; }
  h2 { font-size: 1.8rem; margin: 1.6em 0 0.5em; }
  h3 { font-size: 1.4rem; margin: 1.4em 0 0.4em; }
  a { color: var(--slate); text-underline-offset: 3px; }
  a:hover { color: var(--amber); }
  img { max-width: 100%; height: auto; border-radius: 8px; }
  table { width: 100%; border-collapse: collapse; margin: 1.2em 0; font-size: 0.95rem; display: block; overflow-x: auto; }
  th, td { border: 1px solid var(--line); padding: 0.6em 0.75em; text-align: left; vertical-align: top; }
  th { background: var(--slate); color: #fff; font-family: var(--serif); font-size: 1.05rem; }
  tr:nth-child(even) td { background: var(--cream-soft); }
  .skip-link { position: absolute; left: -9999px; }
  .skip-link:focus { left: 1rem; top: 1rem; background: #fff; padding: 0.5em 1em; z-index: 10; }

  .site-header { background: var(--lime-white); border-bottom: 1px solid var(--line); position: sticky; top: 0; z-index: 5; }
  .header-inner { display: flex; align-items: center; justify-content: space-between; gap: 1rem; padding-top: 0.9rem; padding-bottom: 0.9rem; flex-wrap: wrap; }
  .brand { font-family: var(--serif); font-size: 1.5rem; font-weight: 700; color: var(--slate-deep); text-decoration: none; }
  .site-header nav { display: flex; gap: 1.1rem; flex-wrap: wrap; }
  .site-header nav a { text-decoration: none; font-size: 0.95rem; font-weight: 500; }
  .site-header nav a:hover { color: var(--amber); }

  .hero {
    background: linear-gradient(180deg, var(--slate) 0%, var(--dusk) 100%);
    color: var(--cream);
    padding: 4rem 0 3.5rem;
    text-align: center;
  }
  .hero h1 { color: var(--lime-white); }
  .hero p { color: #e8e2d2; max-width: 620px; margin: 0 auto; }
  .hero .eyebrow { letter-spacing: 0.18em; text-transform: uppercase; font-size: 0.8rem; color: var(--amber-soft); }
  .hero .cta { display: inline-block; margin-top: 1.4rem; background: var(--amber); color: var(--slate-deep); padding: 0.7em 1.4em; border-radius: 999px; text-decoration: none; font-weight: 600; }
  .hero .cta:hover { background: var(--amber-soft); color: var(--slate-deep); }

  /* Hero animation — home page ONLY. Post pages get none of this. */
  body.animate-hero .hero h1,
  body.animate-hero .hero p,
  body.animate-hero .hero .cta { animation: hero-rise 0.9s ease-out both; }
  body.animate-hero .hero p { animation-delay: 0.15s; }
  body.animate-hero .hero .cta { animation-delay: 0.3s; }
  @keyframes hero-rise { from { opacity: 0; transform: translateY(14px); } to { opacity: 1; transform: translateY(0); } }
  @media (prefers-reduced-motion: reduce) {
    body.animate-hero .hero h1, body.animate-hero .hero p, body.animate-hero .hero .cta { animation: none; }
  }

  .page { background: var(--lime-white); padding: 2.5rem 0 3rem; }
  .page-head { margin-bottom: 1.5rem; }
  .post-list { list-style: none; margin: 0; padding: 0; display: grid; gap: 1rem; }
  .post-card { background: var(--lime-white); border: 1px solid var(--line); border-radius: 10px; padding: 1.2rem 1.4rem; }
  .post-card h2, .post-card h3 { margin: 0 0 0.3em; font-size: 1.55rem; }
  .post-card h2 a, .post-card h3 a { text-decoration: none; color: var(--slate-deep); }
  .post-card p { margin: 0.3em 0; color: var(--muted); }
  .meta { font-size: 0.88rem; color: var(--muted); }
  .tag { display: inline-block; background: var(--cream); border: 1px solid var(--line); border-radius: 999px; padding: 0.1em 0.7em; font-size: 0.82rem; margin-right: 0.4em; }

  .disclosure-box {
    background: #fdf6e3; border: 1px solid var(--amber-soft); border-left: 4px solid var(--amber);
    border-radius: 6px; padding: 0.9rem 1.1rem; font-size: 0.95rem; margin: 1.2rem 0;
  }
  .verify-note {
    background: var(--cream); border: 1px dashed var(--dusk); border-radius: 6px;
    padding: 0.9rem 1.1rem; font-size: 0.95rem; margin: 1.2rem 0;
  }
  .prose { max-width: 760px; margin: 0 auto; padding: 2.5rem 1.25rem 3rem; background: var(--lime-white); }
  .prose > h1 { margin-top: 0; }

  .site-footer { background: var(--slate-deep); color: #cfd6de; padding: 2.2rem 0; font-size: 0.95rem; }
  .site-footer a { color: var(--amber-soft); }
  .site-footer .fineprint { font-size: 0.85rem; color: #9aa7b5; }
</style>
