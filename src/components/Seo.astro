---
/**
 * Reusable SEO head. Every page passes title + description (from frontmatter
 * for posts). Canonical, Open Graph, Twitter cards and JSON-LD are built here
 * so no page can forget them.
 *
 * Title rule: 50–60 chars, keyword first.
 * Description rule: max ~155 chars (enforced in the content schema).
 */
import { SITE_AUTHOR, SITE_TITLE, SITE_URL } from '../consts';

interface Props {
  title: string;
  description: string;
  /** 'website' for pages, 'article' for blog posts. */
  type?: 'website' | 'article';
  /** Full canonical URL. Defaults to the current page URL. */
  canonical?: string;
  /** Absolute OG image URL. Defaults to the site OG image. */
  image?: string;
  pubDate?: Date;
  updatedDate?: Date;
  tags?: string[];
  /** Extra JSON-LD object (e.g. Organization on the home page). */
  jsonLd?: Record<string, unknown>;
}

const {
  title,
  description,
  type = 'website',
  image = `${SITE_URL}/og-image.svg`,
  pubDate,
  updatedDate,
  tags = [],
  jsonLd,
} = Astro.props;

// Canonical: current page, resolved against the configured site + base.
const canonical = Astro.props.canonical ?? new URL(Astro.url.pathname, Astro.site ?? SITE_URL).href;
const pageTitle = title === SITE_TITLE ? title : `${title} | ${SITE_TITLE}`;

const articleLd =
  type === 'article'
    ? {
        '@context': 'https://schema.org',
        '@type': 'Article',
        headline: title,
        description,
        author: { '@type': 'Person', name: SITE_AUTHOR },
        datePublished: pubDate?.toISOString(),
        ...(updatedDate ? { dateModified: updatedDate.toISOString() } : {}),
        mainEntityOfPage: canonical,
      }
    : null;
---

<title>{pageTitle}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />
<meta name="author" content={SITE_AUTHOR} />
<meta property="og:type" content={type === 'article' ? 'article' : 'website'} />
<meta property="og:site_name" content={SITE_TITLE} />
<meta property="og:title" content={pageTitle} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={image} />
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={pageTitle} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={image} />
{type === 'article' && pubDate && (
  <meta property="article:published_time" content={pubDate.toISOString()} />
)}
{type === 'article' && updatedDate && (
  <meta property="article:modified_time" content={updatedDate.toISOString()} />
)}
{tags.map((tag) => (
  <meta property="article:tag" content={tag} />
))}
{articleLd && <script type="application/ld+json" set:html={JSON.stringify(articleLd)} />}
{jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
